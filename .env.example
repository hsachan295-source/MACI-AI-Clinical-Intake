# ===========================================================================
# MACI - Multilingual AI Clinical Intake Platform
# Environment variable TEMPLATE. Copy to `.env` and fill in real values.
# The real `.env` file is git-ignored and MUST NOT be committed.
# All secrets below are used ONLY by the FastAPI backend - never the frontend.
# ===========================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Groq (LLM) -------------------------------------------------------------
# Get a key at https://console.groq.com/keys
# Pick a model your key can access - list them with `python scripts/check_groq.py`.
# Good options: openai/gpt-oss-20b (fast), openai/gpt-oss-120b (higher quality).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OCR.Space (Document OCR) --------------------------------------------------
# Get a free key at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng

# --- Pinecone (Vector DB / RAG) --------------------------------------------
# Get a key at https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX_NAME=maci-medical-records
# Must match your Pinecone index's dimension. The offline embedder adapts to the
# live index automatically; set this to your index dim for the pre-connect path
# and for `scripts/index_pinecone.py --create-index`.
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine

# --- Supabase / PostgreSQL -----------------------------------------------------
# Project URL + anon/publishable key from Supabase project settings -> API
SUPABASE_URL=
SUPABASE_KEY=
# Optional: service-role key for server-side ingestion scripts (never expose)
SUPABASE_SERVICE_KEY=

# --- Embeddings -----------------------------------------------------------------
# Options: "auto" (try fastembed/sentence-transformers, else deterministic),
#          "fastembed", "sentence-transformers", "hash" (offline deterministic)
# The offline "hash" embedder produces vectors of EMBEDDING_DIMENSION and
# auto-adapts to the connected Pinecone index dimension.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=1024

# --- Storage / Uploads --------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=15

# --- Safety / Behaviour -----------------------------------------------------
# Max adaptive follow-up questions before the interview auto-completes
MAX_INTERVIEW_QUESTIONS=12
LLM_MAX_RETRIES=2
