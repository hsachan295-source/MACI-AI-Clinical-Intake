# Frontend environment (Vite). ONLY non-secret, public values allowed here.
# Any variable exposed to the browser MUST be prefixed with VITE_.
# NEVER put Groq / OCR / Pinecone / Supabase secret keys in this file.

# Base URL of the MACI FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Optional: public build metadata
VITE_APP_NAME=MACI
